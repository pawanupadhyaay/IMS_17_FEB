NODE_ENV=production
PORT=5000
FRONTEND_URL=https://inventory.samaywatch.in,https://samaywatch.in,https://samaywatch.com
SITE_URL=https://samaywatch.com

MONGODB_URI=
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Samay Watch" <orders@samaywatch.in>

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_FOLDER=ims

# Leave blank to run Shiprocket in mock mode
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=
# Same value as the token set in Shiprocket > Settings > Webhooks (sent as x-api-key)
SHIPROCKET_WEBHOOK_TOKEN=
